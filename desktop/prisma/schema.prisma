// DevFactory Desktop — Local Database Schema
// SQLite local, single-user per installation
// Each customer has their own DB file at userData/devfactory.db

generator client {
  provider = "prisma-client-js"
  output   = "../src/main/db/generated"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// LOCAL USER (single user per installation)
// ============================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastLoginAt  DateTime?

  settings     UserSettings?
  sessions     Session[]
  commandLogs  CommandLog[]
}

model UserSettings {
  id                String   @id @default(cuid())
  userId            String   @unique
  theme             String   @default("cyberpunk")
  language          String   @default("pt-BR")
  minimizeToTray    Boolean  @default(true)
  autoLaunch        Boolean  @default(false)
  voiceEnabled      Boolean  @default(true)
  voiceHotword      String   @default("devfactory")
  telemetryEnabled  Boolean  @default(true)
  cloudSyncEnabled  Boolean  @default(false)
  aiProvider        String   @default("ollama") // ollama | gemini | openai | anthropic
  aiApiKey          String?
  aiModel           String   @default("llama3.1")
  notifications     Boolean  @default(true)
  soundEffects      Boolean  @default(true)

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  userAgent    String?
  ip           String?  // local IP if any
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================
// LICENSE (validated locally, optional cloud check)
// ============================================================

model License {
  id            String    @id @default(cuid())
  key           String    @unique
  hwid          String    @unique
  status        String    @default("ACTIVE") // ACTIVE | EXPIRED | REVOKED | TRIAL
  plan          String    @default("PRO")    // FREE | PRO | ENTERPRISE
  activatedAt   DateTime  @default(now())
  expiresAt     DateTime? // null = lifetime
  trialEndsAt   DateTime?
  lastValidated DateTime  @default(now())
  metadata      String?   // JSON

  @@index([status])
}

// ============================================================
// COMMANDS & AUTOMATION
// ============================================================

model CommandLog {
  id         String   @id @default(cuid())
  userId     String
  command    String
  type       String   @default("TEXT") // TEXT | VOICE | AUTOMATION | AI_QUERY
  source     String   @default("DESKTOP") // DESKTOP | MOBILE | SCHEDULED
  status     String   @default("SUCCESS") // SUCCESS | ERROR | TIMEOUT | PENDING
  response   String?
  duration   Int?     // ms
  metadata   String?  // JSON
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type])
}

model Automation {
  id          String    @id @default(cuid())
  name        String
  description String?
  enabled     Boolean   @default(true)
  trigger     String    // schedule | event | voice | manual
  triggerData String?   // JSON: cron expression, event type, voice pattern
  action      String    // command to execute
  actionData  String?   // JSON: args, env, cwd
  lastRunAt   DateTime?
  runCount    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([enabled])
  @@index([trigger])
}

// ============================================================
// CONTACTS & MESSAGES (future WhatsApp integration)
// ============================================================

model Contact {
  id           String    @id @default(cuid())
  name         String?
  phoneNumber  String    @unique
  email        String?
  labels       String?   // JSON array
  customFields String?   // JSON
  isFavorite   Boolean   @default(false)
  isBlocked    Boolean   @default(false)
  lastMessageAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  messages     Message[]

  @@index([name])
}

model Message {
  id         String    @id @default(cuid())
  contactId  String
  fromMe     Boolean   @default(false)
  type       String    @default("TEXT") // TEXT | IMAGE | VIDEO | AUDIO | DOCUMENT
  body       String?
  mediaUrl   String?
  status     String    @default("PENDING") // PENDING | SENT | DELIVERED | READ | FAILED
  timestamp  DateTime  @default(now())

  contact    Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, timestamp])
}

// ============================================================
// DEVICES (paired mobile devices for remote commands)
// ============================================================

model PairedDevice {
  id           String    @id @default(cuid())
  name         String
  deviceType   String    @default("MOBILE") // MOBILE | TABLET | DESKTOP
  os           String?
  pairingCode  String?   @unique
  publicKey    String?   @unique
  lastSeenAt   DateTime?
  isOnline     Boolean   @default(false)
  isRevoked    Boolean   @default(false)
  metadata     String?   // JSON
  createdAt    DateTime  @default(now())

  @@index([isOnline])
}

// ============================================================
// AI CONVERSATIONS (chat history with AI assistant)
// ============================================================

model AIConversation {
  id         String    @id @default(cuid())
  title      String?
  provider   String    @default("ollama") // ollama | gemini | openai | anthropic
  model      String    @default("llama3.1")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  messages   AIMessage[]

  @@index([createdAt])
}

model AIMessage {
  id              String    @id @default(cuid())
  conversationId  String
  role            String    // user | assistant | system
  content         String
  tokens          Int?      // token count
  metadata        String?   // JSON: model, temperature, etc
  createdAt       DateTime  @default(now())

  conversation    AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
