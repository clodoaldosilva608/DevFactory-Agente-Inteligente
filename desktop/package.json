{
  "name": "devfactory-desktop",
  "version": "3.8.1",
  "description": "DevFactory — Agente Inteligente para PC. Desktop app cyberpunk com IA + automação + controle remoto.",
  "homepage": "https://github.com/clodoaldosilva608/DevFactory-Agente-Inteligente",
  "main": "dist/main/index.js",
  "module": "dist/main/index.js",
  "author": {
    "name": "DevFactory",
    "email": "contato@devfactory.app",
    "url": "https://github.com/clodoaldosilva608"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n MAIN,RENDERER -c cyan,magenta \"bun run dev:main\" \"bun run dev:renderer\"",
    "dev:main": "bun --hot src/main/index.ts",
    "dev:renderer": "vite dev --config vite.renderer.config.ts",
    "build": "bun run build:main && bun run build:renderer && bun run copy:prisma",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "copy:prisma": "node -e \"require('fs').cpSync('src/main/db/generated','dist/main/db/generated',{recursive:true})\"",
    "preview": "electron .",
    "dist": "bun run build && electron-builder --config electron-builder.yml",
    "dist:win": "bun run build && electron-builder --win --config electron-builder.yml",
    "dist:mac": "bun run build && electron-builder --mac --config electron-builder.yml",
    "dist:linux": "bun run build && electron-builder --linux --config electron-builder.yml",
    "clean": "rimraf dist release",
    "lint": "eslint src/",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:push": "prisma db push --schema prisma/schema.prisma --accept-data-loss",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "postinstall": "prisma generate --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "axios": "^1.7.7",
    "bcryptjs": "^3.0.3",
    "electron-log": "^5.2.4",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9",
    "framer-motion": "^13.0.0",
    "lucide-react": "^1.30.0",
    "node-machine-id": "^1.1.12",
    "node-os-utils": "^1.3.7",
    "socket.io": "^4.8.3",
    "systeminformation": "^5.23.13",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/electron-store": "^3.2.2",
    "@types/node": "^22.10.2",
    "@types/node-os-utils": "^1.3.4",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.17.0",
    "postcss": "^8.4.49",
    "prisma": "^6.11.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.0.7",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "app.devfactory.desktop",
    "productName": "DevFactory",
    "directories": {
      "output": "release",
      "buildResources": "build"
    }
  }
}
